// Bubble Sort algorithm

fun bubbleSort(mut arr) {
    let n = len(arr); 

    for (let mut i = 0; i < n; i = i+1) {
        for (let mut j = 1; j < (n-i); j = j+1) {
            if (arr[j-1] > arr[j]) {
                let temp = arr[j-1];
                arr[j-1] = arr[j];
                arr[j] = temp;
            }
        }
    }

    return arr;
}

let mut arr = [3, 44, 38, 5, 47, 15, 36, 26, 27, 2, 46, 4, 19, 50, 48];

bubbleSort(arr);

print(arr); 
