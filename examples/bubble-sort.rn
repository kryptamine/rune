// Bubble Sort algorithm

fun bubbleSort(mut arr) {
    let n = len(arr); 

    for (i in 0..n) {
        for (j in 1..n - i) {
            if (arr[j-1] > arr[j]) {
                let temp = arr[j-1];
                arr[j-1] = arr[j];
                arr[j] = temp;
            }
        }
    }

    return arr;
}

let mut arr = [3, 44, 38, 5, 47, 15, 36, 26, 27, 2, 46, 4, 19, 50, 48];

bubbleSort(arr);

print(arr); 
