// Linked List

fun createNode(data) {
    return {
        data: data,
        next: nil,
    };
}

fun createList(arr) {
    let mut head = nil;
    let mut tail = nil;

    for (let mut i = 0; i < len(arr); i = i+1) {
        let node = createNode(arr[i]);
        if (head == nil) {
            head = node;
            tail = node;
        } else {
            tail["next"] = node;
            tail = node;
        }
    }
    
    tail["next"] = nil;

    return head;
}

fun printList(list) {
    let mut current = list;

    while (current != nil) {
        print(current["data"]);
        current = current["next"];
    }
}

fun reverseList(list) {
    let mut prev = nil;
    let mut current = list;
    let mut next = nil;

    while (current != nil) {
        next = current["next"];
        current["next"] = prev;
        prev = current;
        current = next;
    }

    return prev;
}

let arr = [1, 2, 3, 4, 5];
let mut list = createList(arr);

print("Original list: ");
printList(list);

list = reverseList(list);

print("Reversed list: ");
printList(list);

