// Linked List
//
// Nodes live in one array and link by index: a value never refers to
// another, so a list is a pool of nodes plus the index of its head.

struct Node { data, next }

struct List { nodes = [], head = nil }

impl List {
    fun from(arr) {
        let mut list = List {};
        let mut xs = arr;
        xs.reverse();

        for x in xs {
            list.prepend(x);
        }

        return list;
    }

    fun prepend(mut self, data) {
        self.nodes.push(Node { data, next: self.head });
        self.head = self.nodes.len() - 1;
    }

    fun reverse(mut self) {
        let mut prev = nil;
        let mut current = self.head;

        while current != nil {
            let next = self.nodes[current].next;
            self.nodes[current].next = prev;
            prev = current;
            current = next;
        }

        self.head = prev;
    }

    fun show(self) {
        let mut current = self.head;

        while current != nil {
            print(self.nodes[current].data);
            current = self.nodes[current].next;
        }
    }
}

let mut list = List.from([1, 2, 3, 4, 5]);

print("Original list: ");
list.show();

list.reverse();

print("Reversed list: ");
list.show();
