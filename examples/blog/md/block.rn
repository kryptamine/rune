// Block markdown: headings, paragraphs, lists, fenced code, quotes, rules

import .inline;

export struct Heading { level, text, id }

export struct Doc { html, headings }

struct ListItem { kind, text }

enum ListKind { Bullet, Numbered }

impl ListKind {
    fun tag(self) {
        match self {
            ListKind.Bullet => "ul",
            ListKind.Numbered => "ol",
        }
    }
}

export fun slug(s) { regex.replace(r"[^a-z0-9]+", s.lower(), "-").trim("-") }

export fun render(src) {
    let lines = src.split("\n");
    let mut html = [];
    let mut headings = [];
    let mut i = 0;

    while i < lines.len() {
        let line = lines[i];

        if line.trim() == "" {
            i += 1;
            continue;
        }

        if line.startsWith("```") {
            let lang = line[3..].trim();
            let mut code = [];
            i += 1;

            while i < lines.len() && !lines[i].startsWith("```") {
                code.push(lines[i]);
                i += 1;
            }

            i += 1;
            let cls = if lang == "" { "" } else { " class=\"lang-{lang}\"" };
            html.push("<pre><code{cls}>{inline.escape(code.join("\n"))}</code></pre>");
            continue;
        }

        let h = regex.find(r"^(#{1,6})\s+(.*)$", line);

        if h != nil {
            let [hashes, text] = h.groups;
            let level = hashes.len();
            let id = slug(text);
            headings.push(Heading { level, text, id });
            html.push("""<h{level} id="{id}">{inline.render(text)}</h{level}>""");
            i += 1;
            continue;
        }

        if regex.test(r"^(-{3,}|\*{3,})$", line.trim()) {
            html.push("<hr>");
            i += 1;
            continue;
        }

        if line.startsWith(">") {
            let mut quote = [];

            while i < lines.len() && lines[i].startsWith(">") {
                quote.push(lines[i][1..].trim());
                i += 1;
            }

            html.push("<blockquote><p>{inline.render(quote.join(" "))}</p></blockquote>");
            continue;
        }

        let item = listItem(line);

        if item != nil {
            let tag = item.kind.tag();
            let mut items = [];

            while i < lines.len() {
                let it = listItem(lines[i]);

                if it == nil || it.kind != item.kind {
                    break;
                }

                items.push("<li>{inline.render(it.text)}</li>");
                i += 1;
            }

            html.push("<{tag}>{items.join("")}</{tag}>");
            continue;
        }

        let mut para = [];

        while i < lines.len() && !startsBlock(lines[i]) {
            para.push(lines[i].trim());
            i += 1;
        }

        html.push("<p>{inline.render(para.join(" "))}</p>");
    }

    return Doc { html: html.join("\n"), headings };
}

fun listItem(line) {
    let m = regex.find(r"^\s*([-*]|\d+\.)\s+(.*)$", line);

    if m == nil {
        return nil;
    }

    let [marker, text] = m.groups;
    return ListItem { kind: if marker.endsWith(".") { ListKind.Numbered } else { ListKind.Bullet }, text };
}

fun startsBlock(line) {
    return line.trim() == ""
        || line.startsWith("```")
        || line.startsWith("#")
        || line.startsWith(">")
        || listItem(line) != nil;
}
