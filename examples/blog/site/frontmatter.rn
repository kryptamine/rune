// "---"-delimited key: value header on top of a markdown file

export struct FrontMatterError { message, path, line }

export fun parse(src, path) {
    let lines = src.split("\n");
    if len(lines) == 0 or lines[0].trim() != "---" return { meta: {}, body: src };

    let mut meta = {};
    for i in 1..len(lines) {
        let line = lines[i];
        if line.trim() == "---" {
            return { meta, body: lines.slice(i + 1).join("\n") };
        }
        let m = regex.find(r"^(\w+):\s*(.*)$", line)
            ?? throw FrontMatterError { message: "expected 'key: value'", path, line: i + 1 };
        let [key, value] = m.groups;
        meta[key] = parseValue(value);
    }

    throw FrontMatterError { message: "unterminated front matter", path, line: 1 };
}

fun parseValue(v) {
    if v.startsWith("[") and v.endsWith("]") {
        return v.slice(1, -1).split(",").map(s => s.trim()).filter(s => s != "");
    }
    return match v {
        "true" => true,
        "false" => false,
        _ => v,
    };
}
