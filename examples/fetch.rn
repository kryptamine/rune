// HTTP and JSON into structs: users from DummyJSON, grouped by department
//
//   ./rune run examples/fetch.rn        first 10 users
//   ./rune run examples/fetch.rn 30     first 30

const BASE = "https://dummyjson.com";

struct ApiError { status, message }

struct Point { lat, lng }
struct Address { city, country, coordinates }
struct Company { name, title, department }
struct User { id, firstName, lastName, email, age, address, company, phone = nil }
struct Page { users, total, skip, limit }

// A struct takes the keys it has fields for and skips the rest; nested
// objects come in as maps, so each one is spread into its own struct.
impl Address {
    fun from(m) { Address { ...m, coordinates: Point { ...m["coordinates"] } } }
}

impl User {
    fun from(m) {
        User { ...m, address: Address.from(m["address"]), company: Company { ...m["company"] } }
    }

    fun name(self) { "{self.firstName} {self.lastName}" }
}

impl Page {
    fun from(m) { Page { ...m, users: m["users"].map(User.from) } }
}

fun get(path) {
    let r = http.request("GET", BASE + path, HttpOptions {
        headers: ["Accept": "application/json"],
        timeout: 10,
    });

    let data = json.parse(r.body);

    if r.status != 200 {
        throw ApiError { status: r.status, message: data?.["message"] ?? "HTTP {r.status}" };
    }

    return data;
}

fun section(title) {
    print("");
    print("── {title} " + "─".repeat(math.max(0, 50 - title.len())));
}

fun main([limit = "10"]) {
    let page = try {
        Page.from(get("/users?limit={limit}"))
    } catch e is IOError {
        io.eprint("network: {e.message}");
        return 1;
    };

    section("users {page.skip + 1}-{page.skip + page.users.len()} of {page.total}");

    for u in page.users {
        let { city, country } = u.address;
        print("#{"%-3d".format(u.id)} {u.name().padEnd(22)} {"%2d".format(u.age)}  {city}, {country}");
    }

    section("by department");
    let mut teams = [:];

    for u in page.users {
        let dept = u.company.department;

        if !(dept in teams) {
            teams[dept] = [];
        }

        teams[dept].push(u);
    }

    let mut depts = teams.keys();
    depts.sort();

    for dept in depts {
        let people = teams[dept];
        let ages = people.map(u => u.age);
        let avg = ages.reduce((a, b) => a + b, 0) / ages.len();
        let n = if people.len() == 1 { "1 person" } else { "{people.len()} people" };
        print("{dept.padEnd(26)} {n.padEnd(10)} average age {"%.1f".format(avg)}");
    }

    section("one user");
    let first = User.from(get("/users/{page.users[0].id}"));
    let { lat, lng } = first.address.coordinates;
    print("{first.name()} <{first.email}>, {first.phone ?? "no phone"}");
    print("{first.company.title} at {first.company.name}");
    print("lives at {"%.3f".format(lat)}, {"%.3f".format(lng)}");
    print(json.stringify(first.company));

    section("errors");
    try {
        get("/users/9999");
    } catch e is ApiError {
        print("{e.status}: {e.message}");
    }
}
