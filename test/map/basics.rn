let mut m = [:];
m[1] = "one";
m["1"] = "string one";
m[true] = "yes";
m[nil] = "nothing";
print(m);      // expect: [1: "one", "1": "string one", true: "yes", nil: "nothing"]
print(m[1]);   // expect: one
print(m[1.0]); // expect: one
print(m.len()); // expect: 4
print(m is map); // expect: true

m[1] = "uno";
print(m[1]);   // expect: uno
print(m?.[2]);            // expect: nil
print(m?.[2] ?? "none");  // expect: none
print("1" in m);        // expect: true
print(m.delete("1"));     // expect: true
print(m.delete("1"));     // expect: false
print(m.keys());          // expect: [1, true, nil]
print(m.values());        // expect: ["uno", "yes", "nothing"]
print(m.entries());       // expect: [[1, "uno"], [true, "yes"], [nil, "nothing"]]
m[5] = "five";
print(m[5]); // expect: five
m.clear();
print(m);      // expect: [:]
print(m.len()); // expect: 0

// Insertion order is kept, a deleted key goes to the end when added back.
let mut o = ["b": 1, "a": 2, "c": 3];
o.delete("b");
o["b"] = 4;
for k, v in o { print("{k}={v}"); }
// expect: a=2
// expect: c=3
// expect: b=4
for k in o { print(k); }
// expect: a
// expect: c
// expect: b

struct P { y, x }
print(map(P { y: 1, x: 2 }));          // expect: ["y": 1, "x": 2]
print(map([[1, 2]]) == [1: 2]);        // expect: true
print([1: 2, 3: 4] == [3: 4, 1: 2]);   // expect: true
print([1: 2] == [1: 3]);               // expect: false
print([:] == []);                      // expect: false
print(json.stringify(["b": 1, "a": [2]])); // expect: {"b":1,"a":[2]}

print([[1: "x"]].map(m => m[1])); // expect: ["x"]
