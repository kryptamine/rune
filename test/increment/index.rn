let mut calls = 0;
fun idx() { calls++; return 1; }

let mut arr = [1, 2, 3];
print(arr[idx()]++); // expect: 2
print(++arr[idx()]); // expect: 4
print(arr);          // expect: [1, 4, 3]
print(calls);        // expect: 2

let mut o = {"n": 1};
print(o.n--);    // expect: 1
print(--o["n"]); // expect: -1
