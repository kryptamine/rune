let mut a = 1;
print(a++); // expect: 1
print(a);   // expect: 2
print(++a); // expect: 3
print(a--); // expect: 3
print(--a); // expect: 1
print(a);   // expect: 1

{
  let mut local = 5;
  local++;
  ++local;
  print(local); // expect: 7
  fun f() { local--; return local; }
  print(f()); // expect: 6
}

let mut b = 2;
print(a++ + ++b); // expect: 4
print(-a--);      // expect: -2
print(a);         // expect: 1
