fun kind(f) {
  try { f(); } catch e { return string(e); }
}

print(kind(() => { return 1 + nil; })); // expect: TypeError: Operands must be two numbers, two strings or two bytes.
print(kind(() => { return [][0]; })); // expect: IndexError: Index out of bounds: 0 of 0
print(kind(() => { return [:]["x"]; })); // expect: KeyError: Key not found: "x".
print(kind(() => { return nope; })); // expect: NameError: Undefined variable 'nope'.
print(kind(() => { return math.floor(); })); // expect: ArgumentError: math.floor() expects 1 argument, got 0.
print(kind(() => { return "a".repeat(-1); })); // expect: ValueError: string.repeat() count must not be negative.
print(kind(() => { for i in 0..1 step 0 {} })); // expect: ValueError: Range step must not be zero.

try { 1 + nil; } catch e {
  print(e is TypeError); // expect: true
  print(e is IndexError); // expect: false
  print(e.line); // expect: 13
  print(e.cause); // expect: nil
  print(e); // expect: TypeError: Operands must be two numbers, two strings or two bytes.
}
