fun kind(f) {
  try { f(); } catch (e) { return type(e) + ": " + e.message; }
}

print kind(fun () { return 1 + nil; }); // expect: TypeError: Operands must be two numbers or two strings.
print kind(fun () { return [][0]; }); // expect: IndexError: Index out of bounds: 0 of 0
print kind(fun () { return {}.x; }); // expect: KeyError: Undefined property 'x'.
print kind(fun () { return nope; }); // expect: NameError: Undefined variable 'nope'.
print kind(fun () { return floor(); }); // expect: ArgumentError: floor() expects 1 argument, got 0.
print kind(fun () { return repeat("a", -1); }); // expect: ValueError: repeat() count must not be negative.
print kind(fun () { for (i in 0..1 step 0) {} }); // expect: ValueError: Range step must not be zero.

try { 1 + nil; } catch (e) {
  print e is TypeError; // expect: true
  print e is IndexError; // expect: false
  print e.line; // expect: 13
  print e.cause; // expect: nil
  print e; // expect: TypeError {message: "Operands must be two numbers or two strings.", line: 13, cause: nil}
}
