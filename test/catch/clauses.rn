struct Note { text }
struct ParseError { message, pos, cause = nil }

fun parse(s) {
  try {
    return floor(s);
  } catch (e: TypeError, ValueError) {
    throw ParseError { message: "bad number", pos: 0, cause: e };
  }
}

fun run(f) {
  try {
    f();
  } catch (e: ParseError) {
    print "parse: " + e.message + " <- " + type(e.cause);
  } catch (e: IndexError, KeyError) {
    print "lookup: " + e.message;
  } catch (e) {
    print "other: " + type(e);
  }
}

run(fun () { parse(nil); }); // expect: parse: bad number <- TypeError
run(fun () { [1][5]; }); // expect: lookup: Index out of bounds: 5 of 1
run(fun () { ({}).k; }); // expect: lookup: Undefined property 'k'.
run(fun () { throw Note { text: "boom" }; }); // expect: other: Note

try {
  try {
    [][0];
  } catch (e: TypeError) {
    print "unreachable";
  }
} catch (e: IndexError) {
  print "outer: " + e.message; // expect: outer: Index out of bounds: 0 of 0
}

try {
  throw ValueError { message: "1" };
} catch (e: TypeError) {
  print "unreachable";
} catch {
  print "catch-all"; // expect: catch-all
}

let mut fs = [];
for i in 0..2 {
  try {
    [][i];
  } catch (e: IndexError) {
    push(fs, fun () { return e.message; });
  }
}
print fs[0](); // expect: Index out of bounds: 0 of 0
print fs[1](); // expect: Index out of bounds: 1 of 0

let mut seen = [];
for i in 0..4 {
  try {
    if i == 1 { [][0]; }
    if i == 3 { throw ValueError { message: "stop" }; }
    push(seen, i);
  } catch (e: IndexError) {
    continue;
  } catch (e) {
    break;
  }
}
print seen; // expect: [0, 2]

fun first(xs) {
  try {
    return xs[0];
  } catch (e: IndexError) {
    return "empty";
  }
}
print first([7]); // expect: 7
print first([]); // expect: empty
