// Assignment copies.
let a = [1, 2];
let mut b = a;
b.push(3);
print(a); // expect: [1, 2]
print(b); // expect: [1, 2, 3]

let mut c = [1];
let d = c;
c[0] = 9;
print(d); // expect: [1]
print(c); // expect: [9]

let mut e = [1];
let mut f = [];
f = e;
f.push(2);
print(e); // expect: [1]

// A function without mut cannot change its argument.
fun grow(xs) {
    let mut ys = xs;
    ys.push(0);
    ys[0] = -1;
    return ys;
}

let mut data = [1];
print(grow(data)); // expect: [-1, 0]
print(data); // expect: [1]

// Returning a parameter copies.
fun same(xs) { return xs; }
let mut back = same(data);
back.push(2);
print(data); // expect: [1]

// Elements and properties read into a variable are copies.
let mut grid = [[0, 0], [0, 0]];
let mut row = grid[0];
row[1] = 5;
print(grid); // expect: [[0, 0], [0, 0]]
let snap = grid[1];
grid[1][0] = 7;
print(snap); // expect: [0, 0]
print(grid); // expect: [[0, 0], [7, 0]]
grid[1].push(8);
print(snap); // expect: [0, 0]
print(grid[1]); // expect: [7, 0, 8]

let mut o = { xs: [1] };
let xs = o.xs;
o.xs.push(2);
o.xs[0] = 0;
print(xs); // expect: [1]
print(o.xs); // expect: [0, 2]

// Storing into an element or a literal copies.
let mut inner = [1];
let outer = [inner, { v: inner }];
inner.push(2);
print(outer); // expect: [[1], {v: [1]}]

let mut holder = [[]];
let mut item = [1];
holder[0] = item;
item.push(2);
print(holder); // expect: [[1]]

let mut list = [];
let mut tag = ["a"];
list.push(tag);
list.insert(0, tag);
tag.push("b");
print(list); // expect: [["a"], ["a"]]

// In-place methods on a copy leave the original.
let base = [3, 1, 2];
let mut s1 = base;
s1.sort();
let mut s2 = base;
s2.reverse();
let mut s3 = base;
s3.pop();
let mut s4 = base;
s4.remove(0);
let mut s5 = base;
s5.insert(0, 9);
print(base); // expect: [3, 1, 2]
print([s1, s2, s3, s4, s5]); // expect: [[1, 2, 3], [2, 1, 3], [3, 1], [1, 2], [9, 3, 1, 2]]

// Compound updates through an index copy too.
let mut n1 = [1, 2];
let n2 = n1;
n1[0] += 10;
n1[1]++;
print(n2); // expect: [1, 2]
print(n1); // expect: [11, 3]

// Results of methods that hand out elements are copies.
let mut nested = [[1], [2]];
let mut found = nested.find(x => x[0] == 1);
found.push(0);
let kept = nested.filter(x => true);
nested[1].push(3);
print(nested); // expect: [[1], [2, 3]]
print(kept); // expect: [[1], [2]]
let more = [...nested, [4]];
nested[0][0] = 0;
print(more); // expect: [[1], [2, 3], [4]]
let rep = [[0]].repeat(2);
let mut r0 = rep[0];
r0.push(1);
print(rep); // expect: [[0], [0]]
let mut sl = nested[0..1];
sl[0].push(5);
print(nested[0]); // expect: [0]
let spread = [...nested];
nested[1].pop();
print(spread); // expect: [[0], [2, 3]]
let [first, ...rest] = nested;
nested[0].push(6);
nested[1].push(7);
print(first); // expect: [0]
print(rest); // expect: [[2]]

// A loop iterates the array as it was.
let mut it = [[1], [2]];
for x in it {
    it[1].push(9);
    print(x); // expect: [1]
    break;
}

// A closure over a variable shares the variable, not a copy.
let mut shared = [];
fun add(x) { shared.push(x); }
add(1);
add(2);
print(shared); // expect: [1, 2]
let before = shared;
add(3);
print(before); // expect: [1, 2]

// A captured copy stays as it was.
fun snapshot(xs) { return () => xs; }
let mut live = [1];
let view = snapshot(live);
live.push(2);
print(view()); // expect: [1]

// Constants never change.
const DIRS = [[0, 1], [1, 0]];
let mut dirs = DIRS;
dirs[0][0] = 9;
dirs.push([]);
print(DIRS); // expect: [[0, 1], [1, 0]]
print(dirs); // expect: [[9, 1], [1, 0], []]

// An optional chain writes its copy back too.
let mut opt = { xs: [1] };
let optKeep = opt.xs;
opt?.xs.push(2);
print(opt); // expect: {xs: [1, 2]}
print(optKeep); // expect: [1]

// A parameter keeps its value while the call changes the variable passed.
let mut g = [1];
fun bump() { g.push(2); g[0] = 9; }
fun hold(xs) { bump(); return xs; }
print(hold(g)); // expect: [1]
print(g); // expect: [9, 2]
print(g.map(x => { g[1] = 0; return x; })); // expect: [9, 2]

// A set through a variable the right side reassigns goes back either way.
let mut r1 = [0];
fun re1() { r1 = [5, 5]; return 1; }
r1[0] = re1();
let mut r2 = [0];
let r2Keep = r2;
fun re2() { r2 = [5, 5]; return 1; }
r2[0] = re2();
print([r1, r2]); // expect: [[1], [1]]
