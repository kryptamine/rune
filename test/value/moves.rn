// A read with more reads after it still copies.
let mut a = [1];
let mut b = a;
b.push(2);
print(a); // expect: [1]

// In a loop the next pass reads it again.
let mut base = [0];
let mut runs = [];
for i in 0..2 {
    let mut c = base;
    c.push(i);
    runs.push(c);
}
print(base); // expect: [0]
print(runs); // expect: [[0, 0], [0, 1]]

let mut w = [0];
let mut n = 0;
while n < 2 {
    let mut c = w;
    c[0] = 9;
    n += 1;
}
print(w); // expect: [0]

// A continue goes back to a read.
let mut kept = [1];
for i in 0..3 {
    let mut c = kept;
    if i == 0 { continue; }
    c.push(i);
}
print(kept); // expect: [1]

// A write through it comes after what it is given.
let mut self = [1];
self.push(self);
print(self); // expect: [1, [1]]

let mut cell = [[0]];
cell[0] = cell;
print(cell); // expect: [[[0]]]

// One branch reads it again.
fun branch(flag) {
    let mut x = [1];
    let mut y = [];
    if flag { y = x; } else { y = x; y.push(0); return x; }
    y.push(2);
    return y;
}
print(branch(true)); // expect: [1, 2]
print(branch(false)); // expect: [1]

let mut l = [1];
let m = true && l;
l.push(2);
print(m); // expect: [1]

// A catch reads it after the body fails.
fun caught() {
    let mut x = [1];
    try {
        let mut y = x;
        y.push(2);
        throw "no";
    } catch {
        return x;
    }
}
print(caught()); // expect: [1]

// A defer reads it on the way out.
fun deferred() {
    let mut x = [1];
    defer print(x);
    let mut y = x;
    y.push(2);
    return y;
}
print(deferred());
// expect: [1]
// expect: [1, 2]

// A closure keeps what it captures.
let mut held = [1];
let get = () => held;
let mut copy = held;
copy.push(2);
print(get()); // expect: [1]

// A parameter's array is the caller's.
fun keep(xs) {
    let mut ys = xs;
    ys.push(0);
    return ys;
}
let mut mine = [1];
print(keep(mine)); // expect: [1, 0]
print(mine); // expect: [1]

// A match arm reads it after the guard.
fun guarded() {
    let mut subj = [1];
    let mut g = [];
    let picked = match 1 {
        1 if (g = subj) == nil => 0,
        _ => subj,
    };
    g.push(5);
    return picked;
}
print(guarded()); // expect: [1]

// A destructuring default is a copy.
let mut src = [1];
let [mut d = src] = [];
d.push(2);
print(src); // expect: [1]
struct Empty {}
let { mut e = src } = Empty {};
e.push(3);
print(src); // expect: [1]

// What a call, an index or an operator reads in place it holds till done.
fun change(xs, ys) { let mut zs = ys; zs[0].push(9); return xs; }
fun heldArg() {
    let mut a = [1];
    return change(a, [a]);
}
print(heldArg()); // expect: [1]

fun first(xs, y, z) { return xs; }
fun heldArgs() {
    let mut a = [1];
    let mut b = [];
    return first(a, b = a, b.push(9));
}
print(heldArgs()); // expect: [1]

fun zero(x, y) { return 0; }
fun heldBase() {
    let mut a = [1];
    let mut b = [];
    return try { a[zero(b = a, b.push(9)) + 1] } catch { "out" };
}
print(heldBase()); // expect: out

fun heldOperand() {
    let mut a = [1];
    let mut b = [];
    return "{a}{zero(b = a, b.push(9))}";
}
print(heldOperand()); // expect: [1]0

fun heldSubject() {
    let mut a = [1];
    let mut b = [];
    return match a {
        [x] if (b = a).push(9) != nil => 0,
        _ => a,
    };
}
print(heldSubject()); // expect: [1]

// A caller gives an argument up when it is dead after the call and
// nothing else in the call reads it; a parameter then owns it.
{
    fun grow(xs, x) { let mut ys = xs; ys.push(x); return ys; }
    let mut acc = [];
    for i in 0..3 { acc = grow(acc, i); }
    print(acc); // expect: [0, 1, 2]

    let mut start = [1];
    let out = grow(start, 2);
    print(start); // expect: [1]
    print(out); // expect: [1, 2]

    fun keepSecond(xs, ys) { let mut zs = ys; zs.push(9); return xs; }
    fun twice() { let mut a = [1]; return keepSecond(a, a); }
    print(twice()); // expect: [1]

    fun same(xs) { return xs; }
    fun passOn() { let mut a = [1]; let mut b = same(a); b.push(2); return b; }
    print(passOn()); // expect: [1, 2]

    let g = grow;
    let mut c = [5];
    print(g(c, 6)); // expect: [5, 6]
    print(c); // expect: [5]
}
