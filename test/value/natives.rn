// What a built-in gives out of a container is a copy: changing it leaves
// the container as it was.
let xs = [[1], [2]];

let mut found = xs.find(x => x[0] == 1);
found.push(0);
let mut appended = [...xs, [3]];
appended[0].push(0);
let mut kept = xs.filter(x => true);
kept[1].push(0);
let mut repeated = xs.repeat(2);
repeated[0].push(0);
let mut reduced = xs.reduce((acc, x) => x, []);
reduced.push(0);
let mut mapped = xs.map(x => x);
mapped[0].push(0);
let mut sliced = xs[0..1];
sliced[0].push(0);
let mut spread = [...xs];
spread[0].push(0);
let [mut first, ...rest] = xs;
first.push(0);
print(xs); // expect: [[1], [2]]

let m = ["k": [1]];
let mut mvalues = m.values();
mvalues[0].push(0);
let mut mentries = m.entries();
mentries[0][1].push(0);
let mut asMap = map(m.entries());
asMap["k"].push(0);
print(m); // expect: ["k": [1]]

struct P { items }
let p = P { items: [1] };
let mut fields = map(p);
fields["items"].push(0);
let { items: mut it } = p;
it.push(0);
let { ...mut others } = p;
others["items"].push(0);
let mut q = P { ...p };
let mut qi = q.items;
qi.push(0);
let mut r = P { ...["items": p.items] };
let mut ri = r.items;
ri.push(0);
print(p); // expect: P {items: [1]}
