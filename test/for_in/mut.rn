// Each iteration's variable goes back into its element.
let mut grid = [[0, 0], [0, 0]];
for i, mut row in grid { row[i] = 1; }
print(grid); // expect: [[1, 0], [0, 1]]

// A copy taken before the loop keeps its value.
let before = grid;
for mut row in grid { row.push(7); }
print(before); // expect: [[1, 0], [0, 1]]
print(grid); // expect: [[1, 0, 7], [0, 1, 7]]

let mut nums = [1, 2, 3];
for mut n in nums { n = n * n; }
print(nums); // expect: [1, 4, 9]

// Object and map values.
let mut prices = { apple: 1, pear: 2 };
for k, mut v in prices { v *= 10; }
print(prices); // expect: {apple: 10, pear: 20}

let mut counts = map();
counts["x"] = 1;
for k, mut v in counts { v += 1; }
print(counts); // expect: map {"x": 2}

// continue and break write back too.
let mut xs = [1, 2, 3, 4];
for i, mut x in xs {
    x = 0;
    if i == 1 { continue; }
    if i == 2 { break; }
    x = -1;
}
print(xs); // expect: [-1, 0, 0, 4]

// So do return and throw.
struct Board { rows = [[0], [0]] }
impl Board {
    fun mark(mut self) {
        for mut r in self.rows {
            r[0] = 1;
            return;
        }
    }
}
let mut b = Board {};
b.mark();
print(b.rows); // expect: [[1], [0]]

let mut ys = [1, 2];
try {
    for mut y in ys {
        y = 5;
        throw Error("stop");
    }
} catch e {}
print(ys); // expect: [5, 2]

fun failing() {
    let mut zs = [1, 2];
    defer print(zs); // expect: [9, 2]
    for mut z in zs {
        z = 9;
        throw Error("stop");
    }
}
try { failing(); } catch e {}

let mut seen = [1];
fun failOuter() {
    for mut s in seen {
        s = 8;
        throw Error("stop");
    }
}
try { failOuter(); } catch e {}
print(seen); // expect: [8]

// The loop walks the collection as it was; each variable goes back last.
let mut ws = [[1], [2]];
for mut w in ws {
    ws[1] = [3];
    w.push(0);
}
print(ws); // expect: [[1, 0], [2, 0]]

// A path is read once, before the loop.
let mut o = { rows: [[1], [2]] };
for mut r in o.rows { r.push(r[0] * 10); }
print(o); // expect: {rows: [[1, 10], [2, 20]]}

let mut nested = [[[1]]];
let n0 = nested[0];
for mut r in nested[0] { r.push(2); }
print(nested); // expect: [[[1, 2]]]
print(n0); // expect: [[1]]

// A variable a closure captures goes back, and keeps no hold on the element.
let mut kept = [];
let mut cells = [[0]];
for mut c in cells {
    c.push(1);
    kept.push(() => c);
}
print(cells); // expect: [[0, 1]]
cells[0].push(2);
print(kept[0]()); // expect: [0, 1]
