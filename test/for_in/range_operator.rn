for (i in 1..4) print i;
// expect: 1
// expect: 2
// expect: 3

for (i in 1..=3) print i;
// expect: 1
// expect: 2
// expect: 3

for (i in 3..1) print "never";
for (i in 3..=3) print i; // expect: 3

let n = 2;
for (i in n - 1..n * 2) print i;
// expect: 1
// expect: 2
// expect: 3

for (k, v in 5..7) print k * 10 + v;
// expect: 5
// expect: 16

let a = 0..3;
print len(a); // expect: 3
print a[2]; // expect: 2
print len(1..=1); // expect: 1
print 5..0 step -2; // expect: [5, 3, 1]
print 0..=1 step 0.25; // expect: [0, 0.25, 0.5, 0.75, 1]
print len(0..1 step 0.1); // expect: 10

let step = 2;
for (i in 0..5 step step) print i;
// expect: 0
// expect: 2
// expect: 4

for (i in 3..=1 step -1) print i;
// expect: 3
// expect: 2
// expect: 1

print 0..=0.3 step 0.1; // expect: [0, 0.1, 0.2, 0.3]
print 1..=0 step -0.25; // expect: [1, 0.75, 0.5, 0.25, 0]
