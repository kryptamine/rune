fun make() {
  let mut n = 0;
  fun inc() { n++; return n; }
  fun get() { return n; }
  return [inc, get];
}
let p = make();
p[0]();
p[0]();
print(p[1]()); // expect: 2

fun outer(mut x) {
  fun mid() {
    fun inner() { x = x + 1; return x; }
    return inner;
  }
  return mid();
}
let f = outer(5);
print(f()); // expect: 6
print(f()); // expect: 7

fun counter() {
  let mut c = 0;
  return fun () { c += 1; return c; };
}
let a = counter();
let b = counter();
a();
a();
print(a()); // expect: 3
print(b()); // expect: 1
