let mut fs = [];
for i in 0..3 {
  let j = i * 10;
  push(fs, fun () { return i + j; });
}
for f in fs { print f(); } // expect: 0
// expect: 11
// expect: 22

let mut gs = [];
let mut k = 0;
while k < 3 {
  let c = k;
  push(gs, fun () { return c; });
  k++;
}
for g in gs { print g(); } // expect: 0
// expect: 1
// expect: 2

let mut hs = [];
for key, val in {a: "1", b: "2"} { push(hs, fun () { return key + val; }); }
print hs[0](); // expect: a1
print hs[1](); // expect: b2
