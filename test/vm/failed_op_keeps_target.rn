let mut s = 1;
try { s = s + nil; } catch {}
print(s); // expect: 1

fun f() {
  let mut a = [1];
  let mut x = 5;
  try { x = a[3]; } catch {}
  try { x = -nil; } catch {}
  try { x = x < "a"; } catch {}
  try { x = a.y; } catch {}
  return x;
}
print(f()); // expect: 5

print(len); // expect: <native fn len>
let len = 3;
print(len); // expect: 3

fun early() { return later; }
try { early(); } catch e { print(e.message); } // expect: Undefined variable 'later'.
let later = "now";
print(early()); // expect: now
