enum Shape { Circle { r }, Square { side }, Dot }
enum Color { Red, Green }

print(match Color.Red { Color.Red => 1 });  // Error at 'match': Match does not cover Color.Green; add arms or '_ =>'.

fun area(s) {
  return match s {  // Error at 'match': Match does not cover Shape.Circle, Shape.Dot; add arms or '_ =>'.
    Shape.Circle { r: 0 } => 0,
    Shape.Circle { r } if r > 1 => 3 * r * r,
    Shape.Square { side } => side * side,
  };
}

match Shape.Dot {  // Error at 'match': Match does not cover Shape.Square; add arms or '_ =>'.
  Shape.Dot => print("dot");
  x is Shape.Circle => print(x);
}
