struct Point { x, y }

struct A { b }
struct O { a }
let o = O { a: A { b: 1 } };
let xs = [1];

print(o?.z); // expect: nil
print(o.a?.z?.q); // expect: nil
print(xs?.[5]); // expect: nil
print("ab"?.[9]); // expect: nil
print(Point { x: 1, y: 2 }?.z); // expect: nil
print(o?.a.z); // expect runtime error: [line: 13] KeyError: A has no field 'z'.
