try {
  http.request("GET", 123);
} catch err {
  print(err.message); // expect: http.request() expects a string as argument 2, got number.
}

try {
  json.parse("\{");
} catch e is ValueError {
  print(e.message); // expect: json.parse() could not parse JSON: unexpected end of JSON input
}

try {
  object(nil);
} catch e {
  print(e.message); // expect: object() expects a map or an array of pairs as argument 1, got nil.
}
