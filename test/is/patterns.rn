struct Point { x, y = 0 }
enum Dir { North, South }
const LIMIT = 10;

print(3 is 1..5); // expect: true
print(7 is ..LIMIT); // expect: true
print("b" is "a" | "b"); // expect: true
print(3 is number | string); // expect: true
print({ status: 200, body: "" } is { status: 200..300 }); // expect: true
print([1, 2] is [_, _]); // expect: true
print([1, 2, 3] is [1, ..._]); // expect: true
print(Point { x: 1 } is Point { y: 0 }); // expect: true
print(Dir.North is Dir.North); // expect: true
print(Dir.South is Dir.North); // expect: false
print(Dir.South !is Dir.North); // expect: true
const FIRST = Dir.North;
print(10 is LIMIT); // expect: true
print(Dir.North is FIRST); // expect: true
