print(5 in 1..10); // expect: true
print(10 in 1..10); // expect: false
print(10 in 1..=10); // expect: true
print(0 in 1..10); // expect: false
print(4 in 0..10 step 2); // expect: true
print(5 in 0..10 step 2); // expect: false
print(3 in 10..0 step -1); // expect: true
print(11 in 10..0 step -1); // expect: false
print(2.0 in 1..3); // expect: true
print(2.5 in 1..3); // expect: false
print(0.5 in 0..1 step 0.25); // expect: true
print(1 in 0..1 step 0.25); // expect: false
print(1 in 0..=1 step 0.25); // expect: true
print("a" in 0..10); // expect: false
print(5 !in 1..10); // expect: false
print(math.MAX_INT in 0..=math.MAX_INT); // expect: true
print(1 in 0..1e9 && true); // expect: true
