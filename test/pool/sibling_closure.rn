// A block that creates no closure is recycled; a closure created next to it
// must still see its own variables.
fun make() {
  let x = "outer";
  {
    let tmp = "block";
    print(tmp); // expect: block
  }
  let f = fun () { return x; };
  {
    let other = "again";
    print(other); // expect: again
  }
  return f;
}

print(make()()); // expect: outer
