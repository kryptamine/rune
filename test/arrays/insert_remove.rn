let mut xs = [1, 2, 3];
print(xs.remove(0));       // expect: 1
print(xs.remove(-1));      // expect: 3
print(xs);                 // expect: [2]
print(xs.insert(0, 1));    // expect: nil
xs.insert(2, 3);
xs.insert(-1, 9);
print(xs);                 // expect: [1, 2, 9, 3]

let ys = xs;
xs.remove(2);
print(ys);                 // expect: [1, 2, 3]

try { xs.remove(3); } catch e is IndexError { print(e.message); } // expect: array.remove() index 3 out of bounds of 3 elements.
try { xs.insert(5, 0); } catch e is IndexError { print(e.message); } // expect: array.insert() index 5 out of bounds of 3 elements.
try { [].remove(0); } catch e is IndexError { print(e.message); } // expect: array.remove() index 0 out of bounds of 0 elements.
