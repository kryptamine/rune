let m = ["a": 1];
let s = set([1]);
print(m["a"]); // expect: 1
print(1 in s); // expect: true

let mut mm = m;
mm["b"] = 2;
print(m); // expect: ["a": 1]

let a = [2, 1];
try { let f = a.push; } catch e is TypeError { print(e.message); } // expect: Cannot take method 'push' of array as a value.

// A temporary has no variable to protect.
print([3, 1, 2].sort()); // expect: nil
let mut b = a;
b.push(0);
print(a); // expect: [2, 1]
