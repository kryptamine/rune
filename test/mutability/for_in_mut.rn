let mut grid = [[0, 0], [0, 0]];
for mut row in grid { row[0] = 1; }
print(grid); // expect: [[1, 0], [1, 0]]
let mut nums = [5, 6];
for i, mut x in nums {
  x *= 10;
  print(x); // expect: 50
  // expect: 60
}
print(nums); // expect: [50, 60]
let mut o = ["a": 1];
for k, mut v in o {
  v += 1;
  print(v); // expect: 2
}
print(o); // expect: ["a": 2]
