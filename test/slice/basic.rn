let xs = [1, 2, 3, 4, 5];
print(xs[1..3]); // expect: [2, 3]
print(xs[1..=3]); // expect: [2, 3, 4]
print(xs[..2]); // expect: [1, 2]
print(xs[3..]); // expect: [4, 5]
print(xs[..]); // expect: [1, 2, 3, 4, 5]
print(xs[-2..]); // expect: [4, 5]
print(xs[..-1]); // expect: [1, 2, 3, 4]
print(xs[..=-1]); // expect: [1, 2, 3, 4, 5]
print(xs[..=-2]); // expect: [1, 2, 3, 4]
print(xs[3..1]); // expect: []
print(xs[-10..10]); // expect: [1, 2, 3, 4, 5]

let mut ys = xs[..];
ys.push(6);
print(xs.len()); // expect: 5

let i = 1;
print(xs[i..i + 2]); // expect: [2, 3]
print(xs[..(xs.len() - 1 ?? 0)]); // expect: [1, 2, 3, 4]

print("héllo"[1..3]); // expect: él
print("hello"[..-1]); // expect: hell
print("hello"[10..]); // expect: 
print(b"hello"[1..3]); // expect: b"el"
let mut buf = bytes.buffer("abc");
print(buf[1..]); // expect: b"bc"

let none = nil;
print(none?.[1..]); // expect: nil
print(none?.[1..].len()); // expect: nil
