let x = false;
if !x { print("ok"); } // expect: ok
print(!nil);           // expect: true
print(!0);             // expect: true
print(!(1 == 2));        // expect: true
print(!1 == 2);           // expect: false
print(!true && false); // expect: false
print(!false || false); // expect: true
print(!(!"a"));       // expect: true
let f = (a) => !a;
print(f(nil));            // expect: true
