struct Point { x }

let mut p = Point { x: 1 };

try { array.push(p, 1); } catch (e) { print e.message; }
// expect: array.push() expects an array as argument 1, got Point.
try { array.pop(p); } catch (e) { print e.message; }
// expect: array.pop() expects an array as argument 1, got Point.
try { array.sort(p); } catch (e) { print e.message; }
// expect: array.sort() expects an array as argument 1, got Point.
try { object({x: 1}); } catch (e) { print e.message; }
// expect: object() expects a struct as argument 1, got object.
try { len(Point); } catch (e) { print e.message; }
// expect: len() expects a string, an array, an object, a struct, a Map, a Set or bytes as argument 1, got struct.
