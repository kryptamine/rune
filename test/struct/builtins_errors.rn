struct Point { x }

let mut p = Point { x: 1 };

try { p.push(1); } catch (e) { print e.message; }
// expect: Point has no field 'push'.
try { object({x: 1}); } catch (e) { print e.message; }
// expect: object() expects a struct as argument 1, got object.
try { len(Point); } catch (e) { print e.message; }
// expect: len() expects a string, an array, an object, a struct, a Map, a Set or bytes as argument 1, got struct.
