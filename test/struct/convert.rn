struct Point { x, y = 0 }
struct Box { item, tag = "box" }

print(Point({x: 1})); // expect: Point {x: 1, y: 0}
print(Point({"y": 2, "x": 1})); // expect: Point {x: 1, y: 2}

let p = Point { x: 3 };
print(Point(p) == p); // expect: true
print(Point({x: [1, 2]}).x); // expect: [1, 2]
print(Box({item: Point({x: 5})})); // expect: Box {item: Point {x: 5, y: 0}, tag: "box"}

let mk = Point;
print(mk({x: 7}) is Point); // expect: true

let mut o = {x: 1};
let q = Point(o);
o.x = 2;
print(q.x); // expect: 1
