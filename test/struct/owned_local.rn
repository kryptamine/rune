// A mutable local that never lets its struct go lends it to mut self
// methods, which change it in place once it holds a copy of its own;
// none of these may see it change.
struct P { x = 0, y = 0 }

impl P {
  fun bump(mut self) { self.x++; }
  fun get(self) { return self.x; }
  fun setX(mut self, v) { self.x = v; }
  fun setY(mut self, v) { self.y = v; }
}

fun fresh() {
  let mut p = P {};
  for i in 0..5 { p.setX(p.x + i); }
  p.bump();
  return p.x;
}
print(fresh());                     // expect: 11

fun copied(q) {
  let mut p = q;
  p.setX(5);
  return [p.x, q.x];
}
print(copied(P { x: 1 }));          // expect: [5, 1]

fun reassigned(q) {
  let mut p = P {};
  p.setX(1);
  p = q;
  p.setX(2);
  return [p.x, q.x];
}
print(reassigned(P { x: 7 }));      // expect: [2, 7]

fun inLoop() {
  let mut out = [];
  for i in 0..3 {
    let mut p = P {};
    p.setX(i);
    out.push(p.x);
  }
  return out;
}
print(inLoop());                    // expect: [0, 1, 2]

fun leaked() {
  let mut p = P {};
  let mut kept = [];
  p.setX(1);
  kept.push(p);
  p.setX(2);
  return [kept[0].x, p.x];
}
print(leaked());                    // expect: [1, 2]

fun captured() {
  let mut p = P {};
  let f = () => p.x;
  p.setX(3);
  return f();
}
print(captured());                  // expect: 3

fun bound() {
  let mut p = P { x: 1 };
  let g = p.get;
  p.setX(4);
  return [g(), p.x];
}
print(bound());                     // expect: [1, 4]

fun nested() {
  struct_like();
  let mut p = P {};
  let inner = p;
  p.setY(9);
  return [p.y, inner.y];
}
fun struct_like() {}
print(nested());                    // expect: [9, 0]

fun objects() {
  let mut o = { x: 1 };
  o.x = 2;
  return o.x;
}
print(objects());                   // expect: 2

fun empty() {
  let mut p;
  p = P {};
  p.setX(6);
  return p.x;
}
print(empty());                     // expect: 6
