// A mutable local that never lets its struct go changes it in place once
// it holds a copy of its own; none of these may see it change.
struct P { x = 0, y = 0 }

impl P {
  fun bump(mut self) { self.x++; }
  fun get(self) { return self.x; }
}

fun fresh() {
  let mut p = P {};
  for i in 0..5 { p.x += i; }
  p.bump();
  return p.x;
}
print(fresh());                     // expect: 11

fun copied(q) {
  let mut p = q;
  p.x = 5;
  return [p.x, q.x];
}
print(copied(P { x: 1 }));          // expect: [5, 1]

fun reassigned(q) {
  let mut p = P {};
  p.x = 1;
  p = q;
  p.x = 2;
  return [p.x, q.x];
}
print(reassigned(P { x: 7 }));      // expect: [2, 7]

fun inLoop() {
  let mut out = [];
  for i in 0..3 {
    let mut p = P {};
    p.x = i;
    out.push(p.x);
  }
  return out;
}
print(inLoop());                    // expect: [0, 1, 2]

fun leaked() {
  let mut p = P {};
  let mut kept = [];
  p.x = 1;
  kept.push(p);
  p.x = 2;
  return [kept[0].x, p.x];
}
print(leaked());                    // expect: [1, 2]

fun captured() {
  let mut p = P {};
  let f = () => p.x;
  p.x = 3;
  return f();
}
print(captured());                  // expect: 3

fun bound() {
  let mut p = P { x: 1 };
  let g = p.get;
  p.x = 4;
  return [g(), p.x];
}
print(bound());                     // expect: [1, 4]

fun nested() {
  struct_like();
  let mut p = P {};
  let inner = p;
  p.y = 9;
  return [p.y, inner.y];
}
fun struct_like() {}
print(nested());                    // expect: [9, 0]

fun objects() {
  let mut o = { x: 1 };
  o.x = 2;
  return o.x;
}
print(objects());                   // expect: 2

fun empty() {
  let mut p;
  p = P {};
  p.x = 6;
  return p.x;
}
print(empty());                     // expect: 6
