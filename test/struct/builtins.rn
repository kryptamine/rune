struct Point { x, y = 0 }
struct Empty {}

let p = Point { x: 1 };
print(p is Point); // expect: true
print(Point is struct); // expect: true
print(nil is nil); // expect: true
print(1 is number); // expect: true
print("s" is string); // expect: true
print([] is array); // expect: true
print([:] is map); // expect: true
print(int is function); // expect: true
print((() => {}) is function); // expect: true

print(map(p).len()); // expect: 2
print(map(Empty {}).len()); // expect: 0

let mut o = map(p);
print(o); // expect: ["x": 1, "y": 0]
o["x"] = 5;
print(p.x); // expect: 1
print(map(p) == p); // expect: false
print(Point { ...map(p) } == p); // expect: true
