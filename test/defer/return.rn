fun sign(x) {
  defer print("deferred {x}");
  if x > 0 { return "positive"; }
  return "other";
}
print(sign(1));
// expect: deferred 1
// expect: positive

fun value() {
  let mut n = 1;
  defer n = 100;
  return n;
}
print(value()); // expect: 1

fun early() {
  defer print("cleanup");
  let v = try { int("x") } catch { return 0 };
  return v;
}
print(early());
// expect: cleanup
// expect: 0

struct Counter { n = 0 }
impl Counter {
  fun bump(mut self) {
    defer self.n += 10;
    self.n += 1;
    return self.n;
  }
}
let mut c = Counter {};
print(c.bump()); // expect: 1
print(c.n); // expect: 11
