// A container takes a copy of itself, so it never holds itself.
let mut a = [1];
a[0] = a;
print(a); // expect: [[1]]

let mut m = ["name": "m"];
m["self"] = m;
print(m); // expect: ["name": "m", "self": ["name": "m"]]

// A value held twice is printed in full every time.
let shared = [1, 2];
print([shared, shared]); // expect: [[1, 2], [1, 2]]
