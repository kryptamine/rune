let title = "Hi";

fun page() {
    return """
        <html lang="en">
          <title>{title}</title>

          <p>"quoted" and \{braces}</p>
        </html>
        """;
}

print page();
// expect: <html lang="en">
// expect:   <title>Hi</title>
// expect:
// expect:   <p>"quoted" and {braces}</p>
// expect: </html>

let css = r"""
    a { color: "red"; }
    b \d
    """;
print css;
// expect: a { color: "red"; }
// expect: b \d

print """inline "q" {1 + 1}"""; // expect: inline "q" 2
print len(""); // expect: 0

print """
    {title}{title}
    end
    """ + "|";
// expect: HiHi
// expect: end|

print """
    trailing

    """ + "|";
// expect: trailing
// expect: |

print """
  not dedented: closing is not on its own line""";
// expect:   not dedented: closing is not on its own line
