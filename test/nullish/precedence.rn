// ?? binds looser than "or" and tighter than ranges.
print nil ?? false or true; // expect: true
print false or nil ?? 1; // expect: 1
for i in nil ?? 1..3 { print i; }
// expect: 1
// expect: 2

let mut x = nil;
x = x ?? 5;
print x; // expect: 5

if nil ?? false print "no"; else print "yes"; // expect: yes
