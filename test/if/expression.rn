let x = 5;
print(if x > 3 { "big" } else { "small" }); // expect: big
print(if x > 9 { "a" } else if x > 4 { "b" } else { "c" }); // expect: b
print((if x > 9 { 1 } else { 2 }) + 1); // expect: 3
print(if nil { 1 } else { 0 }); // expect: 0
print(if [0] { 1 } else { 0 }); // expect: 1
print(if x > 9 { 1 }); // expect: nil
print(if x > 9 { 1 } else if x > 7 { 2 }); // expect: nil
print(if x > 3 { print("side"); }); // expect: side
// expect: nil

let parity = n => if n % 2 == 0 { "even" } else { "odd" };
print([1, 2, 3].map(parity)); // expect: ["odd", "even", "odd"]

let mut y = 1;
y = if y > 0 { y + 10 } else { y };
print(y); // expect: 11

let label = if x > 0 {
    let doubled = x * 2;
    "pos {doubled}"
} else {
    "neg"
};
print(label); // expect: pos 10

let mut calls = [];
fun log(v) { calls.push(v); v }
if log(true) { log("then") } else { log("else") }
print(calls); // expect: [true, "then"]

print({ a: if x == 5 { 1 } else { 2 } }); // expect: {a: 1}
print(0..(if x > 2 { 3 } else { 1 })); // expect: [0, 1, 2]
print("{if x > 0 { "pos" } else { "neg" }}"); // expect: pos

let pick = if true { a => a * 2 } else { a => a };
print(pick(4)); // expect: 8

struct P { x }
let p = if x > 0 { P { x } } else { nil };
print(p); // expect: P {x: 5}

let obj = if x > 0 { ({ x }) } else { ({}) };
print(obj); // expect: {x: 5}

let mut src = [1];
let copy = if true { src } else { [] };
src.push(2);
print(src, copy); // expect: [1, 2] [1]

let shadow = if true { let x = 1; x } else { 0 };
print(shadow, x); // expect: 1 5

let mut n = 0;
let looped = if true {
    for i in 0..3 { n += i; }
    n
};
print(looped); // expect: 3
