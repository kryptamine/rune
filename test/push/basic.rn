let mut a = [1];
print(a.push(2)); // expect: 2
print(a.push(3, 4)); // expect: 4
print(a); // expect: [1, 2, 3, 4]

// Arrays are references: push is visible through every alias.
let mut b = a;
b.push(5);
print(a); // expect: [1, 2, 3, 4, 5]

// append still returns a new array and leaves the input alone.
let c = a.append(6);
print(len(a)); // expect: 5
print(len(c)); // expect: 6
