let mut people = [{name: "bob", age: 25}, {name: "ann", age: 31}];
let names = array.map(people, ({ name }) => name);
print names; // expect: ["bob", "ann"]

let ages = array.map(people, ({ age: mut a }) => { a += 1; return a; });
print ages; // expect: [26, 32]

array.sort(people, (a, b) => b.age - a.age);
print array.map(people, p => p.name); // expect: ["ann", "bob"]
