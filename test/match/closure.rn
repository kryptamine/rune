struct Box { v }

let mut fs = [];
for i in 0..3 {
    match Box { v: i } {
        Box { v } if v > 0 => fs.push(() => { return v; }),
        _ => nil,
    }
}

for f in fs print(f());
// expect: 1
// expect: 2

fun guarded(x) {
    return match x {
        n if (() => { return n > 1; })() => "big",
        n => () => { return n; },
    };
}

print(guarded(5));   // expect: big
print(guarded(1)()); // expect: 1
