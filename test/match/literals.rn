fun name(v) {
    return match v {
        nil => "nil",
        0 | 1 => "bit",
        -1 => "minus one",
        2.5 => "two and a half",
        "hi" => "greeting",
        true => "yes",
        false => "no",
        _ => "other",
    };
}

print(name(nil));   // expect: nil
print(name(0));     // expect: bit
print(name(1));     // expect: bit
print(name(-1));    // expect: minus one
print(name(2.5));   // expect: two and a half
print(name("hi"));  // expect: greeting
print(name(true));  // expect: yes
print(name(false)); // expect: no
print(name("1"));   // expect: other
print(name([]));    // expect: other
print(name(0 == 1)); // expect: no
