let mut a = 10;
a += 5;  print a; // expect: 15
a -= 3;  print a; // expect: 12
a *= 2;  print a; // expect: 24
a /= 4;  print a; // expect: 6
a %= 4;  print a; // expect: 2
print a += 1; // expect: 3

let mut s = "ab";
s += "c";
print s; // expect: abc

{
  let mut local = 1;
  local += 1;
  print local; // expect: 2
}
