let { f, n } = { f: () => { return n; }, n: 5 };
print(f()); // expect: 5

fun make() {
  let { mut count } = { count: 0 };
  return () => { count += 1; return count; };
}

let c = make();
c();
print(c()); // expect: 2

fun capture({ x }) {
  return () => { return x; };
}

print(capture({ x: 7 })()); // expect: 7
