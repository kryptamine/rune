struct Pair { f, n }
let { f, n } = Pair { f: () => { return n; }, n: 5 };
print(f()); // expect: 5

fun make() {
  let { n: mut count } = Pair { f: nil, n: 0 };
  return () => { count += 1; return count; };
}

let c = make();
c();
print(c()); // expect: 2

fun capture({ n }) {
  return () => { return n; };
}

print(capture(Pair { f: nil, n: 7 })()); // expect: 7
