struct User { name, tags }
struct Doc { user }
struct Box { pos }
struct N { n }

let { user: { name, tags: [first, ...more] }, size = 1 } = Doc { user: User { name: "ann", tags: ["a", "b", "c"] } };
print(name); // expect: ann
print(first); // expect: a
print(more); // expect: ["b", "c"]
print(size); // expect: 1

let [x, [y, z = 9], { n }] = [1, [2], N { n: 4 }];
print(x + y + z + n); // expect: 16

let { pos: [mut px, py] } = Box { pos: [1, 2] };
px += 10;
print(px, py); // expect: 11 2

let { pos, pos: { n: posN } } = Box { pos: N { n: 3 } };
print(pos, posN); // expect: N {n: 3} 3

fun area({ pos: [w, h] = [1, 1] }) { w * h }
print(area(Box { pos: [3, 4] })); // expect: 12
print(area(N { n: 0 })); // expect: 1

for [key, { n }] in [["a", N { n: 1 }], ["b", N { n: 2 }]] {
    print(key, n);
}
// expect: a 1
// expect: b 2
