let ip = "1.1.1.1";
let hits = 3;
print { ip, hits, n: 1 }; // expect: {hits: 3, ip: "1.1.1.1", n: 1}
print { ip }; // expect: {ip: "1.1.1.1"}
print { ip, ...{ z: 0 }, "k": 1 }; // expect: {ip: "1.1.1.1", k: 1, z: 0}

let wrap = x => { x };
print wrap(2); // expect: {x: 2}

let run = () => { print "block"; };
run(); // expect: block
