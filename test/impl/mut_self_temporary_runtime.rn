struct Counter { n = 0 }

impl Counter {
  fun keys(mut self) { return self.n; }
}

fun make() { return Counter {}; }

print(["a": 1].keys()); // expect: ["a"]
make().keys(); // expect runtime error: [line: 10] TypeError: Cannot call mutating method 'keys' of Counter: the receiver is not a mutable variable, element or property.
