struct Point { x, y }

impl Point {
  fun move(mut self, dx, dy) {
    self.x += dx;
    self.y = self.y + dy;
    self["x"] *= 2;
    self.y++;
  }
}

let mut p = Point { x: 1, y: 1 };
let before = p;
p.move(1, 2);
print(p); // expect: Point {x: 4, y: 4}
print(before); // expect: Point {x: 1, y: 1}
