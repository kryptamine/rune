struct Point { x }

impl Point {
  fun plus(self, k) { return self.x + k; }
}

let p = Point { x: 10 };
print(p?.plus(2)); // expect: 12
let q = nil;
print(q?.plus(2)); // expect: nil
try { let f = p.plus; } catch e is TypeError { print(e.message); } // expect: Cannot take method 'plus' of Point as a value.
try { let f = Point.plus; } catch e is TypeError { print(e.message); } // expect: 'plus' is a method of Point values; call it on one.
try { let f = "a".upper; } catch e is TypeError { print(e.message); } // expect: Cannot take method 'upper' of string as a value.
Point.plus(p, 1); // expect runtime error: [line: 14] TypeError: 'plus' is a method of Point values; call it on one.
