// A mut self owns the structs in its fields.
struct Point { x, y }
struct Line { from, to }

impl Line {
  fun lift(mut self) { self.to.y = 5; }
}

let mut l = Line { from: Point { x: 0, y: 0 }, to: Point { x: 1, y: 1 } };
let before = l;
l.lift();
print(l); // expect: Line {from: Point {x: 0, y: 0}, to: Point {x: 1, y: 5}}
print(before.to); // expect: Point {x: 1, y: 1}
