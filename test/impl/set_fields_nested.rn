struct Point { x, y }
struct Line { from, to, tags }

impl Point {
  fun shift(mut self, d) { self.x += d; }
}

impl Line {
  fun stretch(mut self, d) {
    self.to.shift(d);
    self.tags.k = d;
    self.tags.list[0] = d;
  }
}

let mut l = Line { from: Point { x: 0, y: 0 }, to: Point { x: 1, y: 1 }, tags: { k: 0, list: [0] } };
l.stretch(5);
print(l); // expect: Line {from: Point {x: 0, y: 0}, to: Point {x: 6, y: 1}, tags: {k: 5, list: [5]}}
l.to.shift(1);
print(l.to); // expect: Point {x: 7, y: 1}
