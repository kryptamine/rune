// A mut self goes back when its method returns, over a change the method
// made to the variable another way, as a mut parameter does.
struct P { i = 0 }

impl P {
  fun list(mut self, f) { let a = f(); self.i += 10; return a; }
  fun item(mut self) { self.i++; return self.i; }
  fun nested(mut self) { return self.list(() => self.item()); }
  fun apart(mut self) {
    let add = () => self.item();
    add();
    self.item();
    return self.list(() => 0);
  }
}

let mut ok = P {};
print([ok.apart(), ok.i]); // expect: [0, 12]

let mut g = P {};
fun bump() { g.item(); }
impl P {
  fun viaGlobal(mut self) { bump(); self.i += 100; }
}
g.viaGlobal();
print(g.i); // expect: 100

let mut p = P {};
print(p.nested()); // expect: 1
print(p.i); // expect: 10
