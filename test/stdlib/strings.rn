print string.split("a,b,c", ","); // expect: ["a", "b", "c"]
print string.split("héj", ""); // expect: ["h", "é", "j"]
print array.join([1, "b", true], "-"); // expect: 1-b-true
print array.join([], ","); // expect: 
print string.upper("abc"); // expect: ABC
print string.lower("ABC"); // expect: abc
print string.trim("  hi  ") + "|"; // expect: hi|
print string.startsWith("rune", "ru"); // expect: true
print string.endsWith("rune", "ne"); // expect: true
print string.replace("a-b-c", "-", "+"); // expect: a+b+c
print string.repeat("ab", 3); // expect: ababab
print string.contains("héllo", "llo"); // expect: true
print string.indexOf("héllo", "llo"); // expect: 2
print string.indexOf("abc", "z"); // expect: -1
print string.slice("héllo", 1, 3); // expect: él
print string.slice("héllo", -3); // expect: llo
print string.reverse("héj"); // expect: jéh
