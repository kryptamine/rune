var xs = [3, 1, 2];
print map(xs, fun (x) { return x * 2; }); // expect: [6, 2, 4]
print filter(xs, fun (x) { return x > 1; }); // expect: [3, 2]
print reduce(xs, fun (a, b) { return a + b; }); // expect: 6
print reduce([], fun (a, b) { return a + b; }, 10); // expect: 10
print map(xs, abs); // expect: [3, 1, 2]
print slice(xs, 1); // expect: [1, 2]
print slice(xs, -2, -1); // expect: [1]
print slice(xs, 2, 1); // expect: []
print reverse(xs); // expect: [2, 1, 3]
print xs; // expect: [3, 1, 2]
print contains(xs, 2); // expect: true
print contains([[1]], [1]); // expect: true
print indexOf(xs, 9); // expect: -1
print range(4); // expect: [0, 1, 2, 3]
print range(1, 4); // expect: [1, 2, 3]
print range(5, 0, -2); // expect: [5, 3, 1]
print sort(xs); // expect: [1, 2, 3]
print xs; // expect: [1, 2, 3]
print sort(["b", "c", "a"]); // expect: [a, b, c]
print sort(xs, fun (a, b) { return b - a; }); // expect: [3, 2, 1]

var people = [{name: "bob", age: 25}, {name: "ann", age: 31}, {name: "cid", age: 25}];
sort(people, fun (a, b) { return a.age - b.age; });
print map(people, fun (p) { return p.name; }); // expect: [bob, cid, ann]

// User code may shadow a builtin.
fun map(a, f) { return "mine"; }
print map([], abs); // expect: mine
