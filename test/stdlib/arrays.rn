let mut xs = [3, 1, 2];
print array.map(xs, fun (x) { return x * 2; }); // expect: [6, 2, 4]
print array.filter(xs, fun (x) { return x > 1; }); // expect: [3, 2]
print array.reduce(xs, fun (a, b) { return a + b; }); // expect: 6
print array.reduce([], fun (a, b) { return a + b; }, 10); // expect: 10
print array.map(xs, math.abs); // expect: [3, 1, 2]
print array.slice(xs, 1); // expect: [1, 2]
print array.slice(xs, -2, -1); // expect: [1]
print array.slice(xs, 2, 1); // expect: []
print array.reverse(xs); // expect: [2, 1, 3]
print xs; // expect: [3, 1, 2]
print array.contains(xs, 2); // expect: true
print array.contains([[1]], [1]); // expect: true
print array.indexOf(xs, 9); // expect: -1
print array.sort(xs); // expect: [1, 2, 3]
print xs; // expect: [1, 2, 3]
print array.sort(["b", "c", "a"]); // expect: ["a", "b", "c"]
print array.sort(xs, fun (a, b) { return b - a; }); // expect: [3, 2, 1]

let mut people = [{name: "bob", age: 25}, {name: "ann", age: 31}, {name: "cid", age: 25}];
array.sort(people, fun (a, b) { return a.age - b.age; });
print array.map(people, fun (p) { return p.name; }); // expect: ["bob", "cid", "ann"]

// User code may shadow a namespace.
{
    let array = {map: fun (a, f) { return "mine"; }};
    print array.map([], math.abs); // expect: mine
}
