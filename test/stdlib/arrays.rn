let mut xs = [3, 1, 2];
print(xs.map(fun (x) { return x * 2; })); // expect: [6, 2, 4]
print(xs.filter(fun (x) { return x > 1; })); // expect: [3, 2]
print(xs.reduce(fun (a, b) { return a + b; })); // expect: 6
print([].reduce(fun (a, b) { return a + b; }, 10)); // expect: 10
print(xs.map(math.abs)); // expect: [3, 1, 2]
print(xs.slice(1)); // expect: [1, 2]
print(xs.slice(-2, -1)); // expect: [1]
print(xs.slice(2, 1)); // expect: []
print(xs.reverse()); // expect: [2, 1, 3]
print(xs); // expect: [3, 1, 2]
print(xs.contains(2)); // expect: true
print([[1]].contains([1])); // expect: true
print(xs.indexOf(9)); // expect: -1
print(xs.sort()); // expect: nil
print(xs); // expect: [1, 2, 3]
xs.sort(fun (a, b) { return b - a; });
print(xs); // expect: [3, 2, 1]

let mut people = [{name: "bob", age: 25}, {name: "ann", age: 31}, {name: "cid", age: 25}];
people.sort(fun (a, b) { return a.age - b.age; });
print(people.map(fun (p) { return p.name; })); // expect: ["bob", "cid", "ann"]
