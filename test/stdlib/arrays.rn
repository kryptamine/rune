let mut xs = [3, 1, 2];
print(xs.map(x => { return x * 2; })); // expect: [6, 2, 4]
print(xs.filter(x => { return x > 1; })); // expect: [3, 2]
print(xs.reduce((a, b) => { return a + b; })); // expect: 6
print([].reduce((a, b) => { return a + b; }, 10)); // expect: 10
print(xs.map(math.abs)); // expect: [3, 1, 2]
print(xs[1..]); // expect: [1, 2]
print(xs[-2..-1]); // expect: [1]
print(xs[2..1]); // expect: []
print(xs.reverse()); // expect: nil
print(xs); // expect: [2, 1, 3]
xs.reverse();
print(2 in xs); // expect: true
print([1] in [[1]]); // expect: true
print(xs.sort()); // expect: nil
print(xs); // expect: [1, 2, 3]
xs.sort((a, b) => { return b - a; });
print(xs); // expect: [3, 2, 1]

let mut people = [{name: "bob", age: 25}, {name: "ann", age: 31}, {name: "cid", age: 25}];
people.sort((a, b) => { return a.age - b.age; });
print(people.map(p => { return p.name; })); // expect: ["bob", "cid", "ann"]
