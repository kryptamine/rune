print(string(1.5) + "!"); // expect: 1.5!
print(string("hi")); // expect: hi
print(string([1, "a"])); // expect: [1, "a"]
print(string(nil)); // expect: nil
print(string(-0)); // expect: 0
print(string(1e21)); // expect: 1e+21
print(string(1e20)); // expect: 100000000000000000000
print(1e-7);      // expect: 1e-7
print(math.floor(1e300)); // expect: 1e+300
print(-math.INF); // expect: -inf

print(number("42") + 1); // expect: 43
print(number(" -2.5e1 ")); // expect: -25
print(number("1E+2")); // expect: 100
print(number(7)); // expect: 7

print(int("42")); // expect: 42
print(int(" -17 ")); // expect: -17
print(int("ff", 16)); // expect: 255
print(int("101", 2)); // expect: 5
print(int(3.9)); // expect: 3
print(int(-3.9)); // expect: -3

for s in ["abc", "inf", "0x", "", "-", ".5", "5.", "+1", "1e", "1e400", "1 2"] {
    try { number(s); } catch e is ValueError { print(e.message); }
}
// expect: number() cannot parse "abc" as a number.
// expect: number() cannot parse "inf" as a number.
// expect: number() cannot parse "0x" as a number.
// expect: number() cannot parse "" as a number.
// expect: number() cannot parse "-" as a number.
// expect: number() cannot parse ".5" as a number.
// expect: number() cannot parse "5." as a number.
// expect: number() cannot parse "+1" as a number.
// expect: number() cannot parse "1e" as a number.
// expect: number() cannot parse "1e400" as a number.
// expect: number() cannot parse "1 2" as a number.

try { number(nil); } catch e is TypeError { print(e.message); } // expect: number() expects a number or a string as argument 1, got nil.
try { int("3.5"); } catch e is ValueError { print(e.message); } // expect: int() cannot parse "3.5" as an integer in base 10.
try { int("1_000"); } catch e is ValueError { print(e.message); } // expect: int() cannot parse "1_000" as an integer in base 10.
try { int("z", 37); } catch e is ValueError { print(e.message); } // expect: int() expects a base from 2 to 36, got 37.
try { int(10, 2); } catch e is TypeError { print(e.message); } // expect: int() expects a string as argument 1, got number.
try { int(math.INF); } catch e is ValueError { print(e.message); } // expect: int() cannot convert inf to an integer.

print(3.14159.fixed(2)); // expect: 3.14
print(2.fixed(3)); // expect: 2.000
print(2.5.fixed(0)); // expect: 2
print((-0.001).fixed(1)); // expect: -0.0
print((-0).fixed(2)); // expect: 0.00
try { 1.fixed(101); } catch e is ValueError { print(e.message); } // expect: number.fixed() expects 0 to 100 digits, got 101.
try { 1.fixed(1.5); } catch e is TypeError { print(e.message); } // expect: number.fixed() expects an integer as argument 1, got number.
print(number("1_000")); // expect: 1000
print(number("0xff")); // expect: 255
print(number(" -0b101 ")); // expect: -5
print(number("1_000.5")); // expect: 1000.5

struct User { name, role = "guest" }
print(object());                               // expect: {}
print(object(User { name: "ann" }));           // expect: {name: "ann", role: "guest"}
print(object(map([["b", 1], ["a", 2]])));      // expect: {b: 1, a: 2}
print(object([["x", 1], ["y", [2]]]));         // expect: {x: 1, y: [2]}
let src = { a: 1 };
let mut copy = object(src);
copy.b = 2;
print([src, copy]);                            // expect: [{a: 1}, {a: 1, b: 2}]
try { object(map([[1, 2]])); } catch e is TypeError { print(e.message); } // expect: object() expects string keys, got 1.
try { object([1]); } catch e is TypeError { print(e.message); }           // expect: object() expects [key, value] pairs, got 1.

print([1, "a", nil].map(string));              // expect: ["1", "a", "nil"]
print(["hi"].map(bytes));                      // expect: [b"hi"]
print([{ name: "bob" }].map(User));            // expect: [User {name: "bob", role: "guest"}]
try { [1].map(math); } catch e is TypeError { print(e.message); } // expect: array.map() expects a function as argument 1, got namespace.
print(map(User { name: "ann" }));              // expect: map {"name": "ann", "role": "guest"}
