print json.parse("\{\"a\": [1, 2.5, null, true], \"b\": \"x\"}"); // expect: {a: [1, 2.5, nil, true], b: "x"}
print json.parse("3"); // expect: 3
print json.stringify({b: [1, nil, false], a: "q\"\n\t"}); // expect: {"a":"q\"\n\t","b":[1,null,false]}
print json.stringify(1e21) + " " + json.stringify(0.0000001) + " " + json.stringify(-0.5); // expect: 1e+21 1e-7 -0.5

struct P { x, y = 2 }
print json.stringify(P { x: 1 }); // expect: {"x":1,"y":2}
print json.parse(json.stringify([{k: "é"}])) == [{k: "é"}]; // expect: true

try { json.stringify(fun () {}); } catch (e: TypeError) { print e.message; } // expect: json.stringify() cannot encode function.
try { json.stringify(math.INF); } catch (e: ValueError) { print e.message; } // expect: json.stringify() cannot encode a non-finite number.

let mut xs = [];
xs.push(xs);
try { json.stringify(xs); } catch (e: ValueError) { print e.message; } // expect: json.stringify() cannot encode a cyclic or too deeply nested value.
